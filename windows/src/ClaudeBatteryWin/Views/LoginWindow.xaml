<Window x:Class="ClaudeBatteryWin.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sign in to Claude"
        Width="480"
        Height="640"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource LoginBackgroundBrush}">
    <!-- The embedded login WebView2 plus a single overlay layer for the signing-in spinner and the
         recoverable error card. The WebView2 uses an ephemeral InPrivate environment with an
         isolated user-data folder, created in the code-behind and deleted on Dispose (with a
         startup sweep of stale login UDFs). The host window stays open through capture and org
         discovery; it closes only on success or teardown. -->
    <Window.Resources>
        <SolidColorBrush x:Key="LoginBackgroundBrush" Color="#FF1E1E1E" />
        <SolidColorBrush x:Key="LoginOverlayBackgroundBrush" Color="#E6202020" />
        <SolidColorBrush x:Key="LoginOverlayForegroundBrush" Color="#FFF3F3F3" />
        <SolidColorBrush x:Key="LoginOverlayMutedBrush" Color="#FFB0B0B0" />
        <SolidColorBrush x:Key="LoginOverlayErrorBrush" Color="#FFE74C3C" />
    </Window.Resources>

    <Grid>
        <wv2:WebView2 x:Name="WebView" />

        <!-- Signing-in overlay: "Finishing sign-in…" with an indeterminate bar. Mirrors the Mac
             signing-in overlay; AutomationProperties label for Narrator. -->
        <Border x:Name="SigningInOverlay"
                Background="{DynamicResource LoginOverlayBackgroundBrush}"
                Visibility="Collapsed"
                AutomationProperties.Name="Finishing sign-in">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="280">
                <TextBlock Text="Finishing sign-in…"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           Foreground="{DynamicResource LoginOverlayForegroundBrush}" />
                <ProgressBar IsIndeterminate="True"
                             Height="4"
                             Margin="0,16,0,0" />
            </StackPanel>
        </Border>

        <!-- Recoverable error card shown when org discovery fails: message + Try again + Sign in
             manually. The window stays open so the user can recover in place. -->
        <Border x:Name="ErrorOverlay"
                Background="{DynamicResource LoginOverlayBackgroundBrush}"
                Visibility="Collapsed"
                AutomationProperties.Name="Sign-in problem">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="360"
                        Margin="20">
                <TextBlock Text="Couldn't finish sign-in"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource LoginOverlayForegroundBrush}" />
                <TextBlock x:Name="ErrorMessageText"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Foreground="{DynamicResource LoginOverlayMutedBrush}" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0">
                    <Button x:Name="RetryButton"
                            Content="Try again"
                            MinWidth="96"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            IsDefault="True"
                            Click="OnRetryClicked" />
                    <Button x:Name="ManualButton"
                            Content="Sign in manually"
                            MinWidth="96"
                            Padding="12,6"
                            Click="OnManualClicked" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

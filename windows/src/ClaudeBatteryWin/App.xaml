<Application x:Class="ClaudeBatteryWin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             ShutdownMode="OnExplicitShutdown">
    <!-- No StartupUri: this is a windowless tray app (R1). The TaskbarIcon below is the only
         persistent UI surface; the flyout and login/settings windows are created on demand.
         ShutdownMode=OnExplicitShutdown is REQUIRED: with the WPF default (OnLastWindowClose) the
         process starts with zero windows and would quit the moment the first on-demand window (e.g.
         Settings) is closed, taking the tray icon with it. Every real exit path calls Shutdown()
         explicitly (the tray Quit item and the second-instance bail), so nothing else changes. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Tray icon resource dictionary. Kept inline here for U1; theme token
                     dictionaries (light/dark) merge in later (U9/U10). -->
                <ResourceDictionary>
                    <!-- The tray icon. Registered with a stable GUID so Shell_NotifyIconGetRect
                         (U10 flyout placement) can key on it. The Id GUID MUST stay constant
                         across versions or Windows treats it as a new icon and loses pinning. -->
                    <tb:TaskbarIcon x:Key="TrayIcon"
                                    Id="7E2C1B44-9F3A-4D21-B8E6-0C5A1F2D3E40"
                                    ToolTipText="Claude Battery"
                                    Visibility="Visible"
                                    NoLeftClickDelay="True"
                                    MenuActivation="RightClick">
                        <!-- The tray icon is driven imperatively from the composition root
                             (App.AcquireTrayIcon): the TaskbarIcon.Icon (System.Drawing.Icon) is set
                             from the Dual Horizontal renderer output (U9), the left-click is handled
                             via the TrayLeftMouseUp event (-> ShowFlyout), and the ContextMenu is
                             built in code. No LeftClickCommand binding here, since this resource has
                             no DataContext and the click is wired in code instead. -->
                    </tb:TaskbarIcon>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>ClaudeBatteryWin</RootNamespace>
    <AssemblyName>ClaudeBatteryWin</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Single-instance, no Dock/taskbar presence: the TaskbarIcon is declared in App.xaml
         and there is no StartupUri, so the process runs windowless. -->

    <!-- Self-contained single-file publish. IncludeNativeLibrariesForSelfExtract bundles
         WebView2Loader.dll into the single file (it is a native dependency).
         The single-file vs Velopack-bundle reconciliation is decided by the U13 spike before
         service code depends on the stable current\App.exe path. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebView2: pinned. Login cookie capture (GetCookiesAsync) + runtime bootstrap (U6/U8). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
    <!-- Windowless tray icon (H.NotifyIcon.Wpf, maintained Hardcodet successor). -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.3" />
    <!-- DPAPI at-rest secret encryption (U5). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- In-app auto-update with a stable current\ path (U12). -->
    <PackageReference Include="Velopack" Version="0.0.598" />
    <!-- GDI+ for tray-icon bitmap composition (U9). -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.7" />
  </ItemGroup>

</Project>
